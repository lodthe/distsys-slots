server {
    listen 80;
    listen [::]:80;
    server_name slots.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name slots.example.com;

    # Obtain a certificate for your domain before enabling this configuration.
    ssl_certificate /etc/letsencrypt/live/slots.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/slots.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    charset utf-8;
    client_max_body_size 128k;

    location / {
        proxy_pass http://127.0.0.1:8083;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 35s;
        proxy_send_timeout 35s;
        proxy_cache off;
    }
}

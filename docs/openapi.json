                    "$ref": "#/components/schemas/Slot"
                  }
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 401 expired session; 403 role/CSRF/origin; 404 inaccessible object; 409 scheduling conflict; 429 rate limit; 500 internal error.",
            "content": {
              "application/json": {

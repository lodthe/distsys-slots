{
  "openapi": "3.0.3",
  "info": {
    "title": "DistSys slots API",
    "version": "0.4.0",
    "description": "Three roles: admin manages homework numbers and defense dates; assistants publish only on allowed dates; students provide a full name and repository username. Participant names, repository links and Telegram username are returned only to the owning assistant, never by admin calendar endpoints. Verified Telegram sessions; mutations require Origin and X-CSRF-Token. Administrators can use assistant and student endpoints without a separate assistant role; assistants can also use student endpoints. Resource ownership checks still apply. The monthly calendar exposes anonymous counts, not participant identities. Staff display uses only @username from verified Telegram data, or Ассистент if missing; never Telegram first/last names. Roles are assigned through the operator CLI."
  },
  "servers": [
    {
      "url": "https://slots.example.com/api/v1"
    }
  ],
  "security": [
    {
      "session": []
    }
  ],
  "paths": {
    "/auth/telegram": {
      "post": {
        "summary": "Verify Telegram initData and issue a one-hour secure session",
        "parameters": [
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string",
              "example": "https://slots.example.com"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "csrf_token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 401 expired session; 403 role/CSRF/origin; 404 inaccessible object; 409 scheduling conflict; 429 rate limit; 500 internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "init_data": {
                    "type": "string"
                  }
                },
                "required": [
                  "init_data"
                ]
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Current profile, roles and CSRF token",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/User"
                    },
                    "csrf_token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 401 expired session; 403 role/CSRF/origin; 404 inaccessible object; 409 scheduling conflict; 429 rate limit; 500 internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Update own profile",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string",
              "example": "https://slots.example.com"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 401 expired session; 403 role/CSRF/origin; 404 inaccessible object; 409 scheduling conflict; 429 rate limit; 500 internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "full_name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "repository_username": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Suffix of https://distsys.ru/hse-2026/. Whitespace and forward/back slashes are forbidden; other characters are accepted and URL-escaped."
                  }
                },
                "required": [
                  "full_name",
                  "repository_username"
                ],
                "additionalProperties": false,
                "description": "Private full name and repository username. Telegram staff identity is unchanged."
              }
            }
          }
        }
      }
    },
    "/homeworks": {
      "get": {
        "summary": "Active homework catalog",
        "parameters": [],
        "responses": {

    "/calendar": {
      "get": {
        "summary": "Monthly anonymous counts grouped by Moscow day, homework and assistant; future open slots only, including fully booked groups. No pagination.",
        "parameters": [
          {
            "in": "query",
            "name": "month",
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}$"
            },
            "description": "Defaults to the current Moscow month"
          },
          {
            "in": "query",
            "name": "homework_id",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Monthly calendar entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CalendarEntry"
                  }
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 401 expired session; 403 role/CSRF/origin; 404 inaccessible object; 409 scheduling conflict; 429 rate limit; 500 internal error.",
            "content": {

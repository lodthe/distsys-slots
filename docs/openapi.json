            "name": "id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string",
              "example": "https://slots.example.com"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "comment": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 401 expired session; 403 role/CSRF/origin; 404 inaccessible object; 409 scheduling conflict; 429 rate limit; 500 internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "comment"
                ],
                "additionalProperties": false,
                "properties": {
                  "comment": {
                    "type": "string",
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "distsys_session"
      }
    },
    "schemas": {
      "WindowInput": {
        "type": "object",
        "properties": {
          "homework_id": {
            "type": "integer",
            "format": "int64"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "slot_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 180
          },
          "excluded_slot_indices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439
            },
            "uniqueItems": true,
            "maxItems": 1439,
            "description": "Optional zero-based indices of generated full slots to omit atomically. Each index must be less than floor(window minutes / slot_minutes); at least one slot must remain. Omitted/empty means all slots. Other start times do not shift."
          },
          "comment": {
            "type": "string",
            "maxLength": 2000,
            "default": "",
            "description": "Optional comment shared by the window slots. Included only in the booked student reminder 5 minutes before the slot; the current value is read at delivery."
          }
        },
        "required": [
          "homework_id",
          "starts_at",
          "ends_at",
          "slot_minutes"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "telegram_id": {
            "type": "integer",
            "format": "int64"
          },
          "full_name": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "assistant": {
            "type": "boolean",
            "description": "Explicit assistant role. Assistant access is allowed when assistant OR admin is true."
          },
          "admin": {
            "type": "boolean"
          },
          "repository_username": {
            "type": "string"
          },
          "repository_url": {
            "type": "string",
            "description": "Fixed repository base plus an escaped username; empty until supplied."
          }
        }
      },
      "Homework": {
        "allOf": [
          {
            "$ref": "#/components/schemas/HomeworkInput"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "title": {
                "type": "string",
                "example": "ДЗ №1"
              },
              "window_count": {
                "type": "integer"
              }
            }
          }
        ]
      },
      "Slot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "window_id": {
            "type": "integer",
            "format": "int64"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "window_status": {
            "type": "string"
          },
          "homework_id": {
            "type": "integer",
            "format": "int64"
          },
          "homework_title": {
            "type": "string"
          },
          "assistant_id": {
            "type": "integer",
            "format": "int64"
          },
          "assistant_name": {
            "type": "string"
          },
          "assistant_username": {
            "type": "string"
          },
          "booked": {
            "type": "boolean"
          }
        }
      },
      "Window": {
        "allOf": [
          {
            "$ref": "#/components/schemas/WindowInput"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "assistant_id": {
                "type": "integer",
                "format": "int64"
              },
              "status": {
                "type": "string"
              },
              "cancellation_reason": {
                "type": "string"
              },
              "homework_title": {
                "type": "string"
              },
              "slot_count": {
                "type": "integer",
                "format": "int64"
              },
              "booking_count": {
                "type": "integer",
                "format": "int64"
              },
              "slots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "description": "Slot fields plus booking_id, full_name, username, repository_username and repository_url. Only the owning assistant can see participants. No student_group or Telegram numeric ID."
                }
              }
            }
          }
        ]
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "slot_id": {
            "type": "integer",
            "format": "int64"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "cancelled_by_student",
              "cancelled_by_assistant"
            ]
          },
          "cancellation_reason": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          },
          "homework_title": {
            "type": "string"
          },
          "assistant_name": {
            "type": "string"
          },
          "assistant_username": {
            "type": "string"
          }
        }
      },
      "HomeworkInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "defense_dates"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "defense_dates": {
            "type": "array",
            "minItems": 1,
            "maxItems": 366,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "CalendarEntry": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "format": "date"
          },
          "homework_id": {
            "type": "integer",
            "format": "int64"
          },
          "homework_title": {
            "type": "string"
          },
          "assistant_id": {
            "type": "integer",
            "format": "int64"
          },
          "assistant_name": {
            "type": "string"
          },
          "free_slots": {
            "type": "integer"
          },
          "total_slots": {
            "type": "integer"
          },
          "first_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}

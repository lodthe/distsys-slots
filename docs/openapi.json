    "/assistant/windows": {
      "get": {
        "summary": "All own windows, newest first",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Window"
                  }
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 401 expired session; 403 role/CSRF/origin; 404 inaccessible object; 409 scheduling conflict; 429 rate limit; 500 internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "All own past, future and cancelled windows in one response, ordered by starts_at DESC, id DESC. No pagination or date filters."
      },
      "post": {
        "summary": "Publish one window (assistant)",
        "parameters": [
          {
            "in": "header",
            "name": "X-CSRF-Token",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "Origin",
            "required": true,
            "schema": {
              "type": "string",
              "example": "https://slots.example.com"
            }
          },
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer",
                      "format": "int64"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 401 expired session; 403 role/CSRF/origin; 404 inaccessible object; 409 scheduling conflict; 429 rate limit; 500 internal error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WindowInput"
              }
            }
          }
        },
        "description": "Publishes one window and its slots atomically. Overlapping windows are allowed. Future times, allowed defense dates, slot exclusions and idempotency are checked. Repeating the same request with the same Idempotency-Key returns the original window ID."
      }
    },
